#!/usr/bin/env bash
# Test double. Logs every invocation and never talks to a real systemd.
set -euo pipefail

log="${SYSTEMCTL_LOG:-/dev/null}"
printf '%s\n' "$*" >>"$log"

if [[ "${1:-}" == "--user" ]]; then
  shift
fi

cmd="${1:-}"
case "$cmd" in
  show)
    shift
    if [[ "${1:-}" == "-p" ]]; then
      prop="${2:-}"
      printf '%s=%s\n' "$prop" "${MOCK_SHOW_VALUE:-/var/lib/mock}"
      exit 0
    fi
    unit="${1:-unit}"
    printf 'Id=%s\n' "$unit"
    printf 'FragmentPath=/var/lib/mock/%s\n' "$unit"
    printf 'WorkingDirectory=%s\n' "${MOCK_WORKDIR:-/var/lib/mock}"
    printf 'ActiveState=active\n'
    exit 0
    ;;
  daemon-reload)
    if [[ "${MOCK_DAEMON_RELOAD_FAIL:-0}" == "1" ]]; then
      echo "mock daemon-reload failed" >&2
      exit 1
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
